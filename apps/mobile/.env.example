# Local Android emulator only; use your LAN host for a physical device.
# Optional database-free development demo; keep false for real backend use.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000
# Public native Maps key: restrict by application ID and signing certificate.
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=
# Production requires real HTTPS API/socket URLs. Never place JWTs or server
# secrets in EXPO_PUBLIC variables. iOS uses Apple Maps (no Google key needed).
