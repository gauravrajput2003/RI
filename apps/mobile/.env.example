# Empty URLs discover the API on the Metro computer (phone) or browser host (web).
# Use explicit HTTPS URLs for deployed builds. Local API must run on port 3000.
# Optional database-free development demo; keep false for real backend use.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOCKET_URL=
# Public native Maps key: restrict by application ID and signing certificate.
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=AIzaSyBaipIOvgnkkyVCv6zNCuLGlBQ6tMtnoe8
