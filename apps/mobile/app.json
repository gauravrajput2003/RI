{
  "expo": {
    "name": "Fleet Tracker",
    "slug": "ri-gps-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fleettracker",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.fleettracker"
    },
    "android": {
      "package": "com.example.fleettracker",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ac0ec99-50ce-4d78-b243-c7272a664fd4"
      }
    },
    "owner": "gpstrackerss-team"
  }
}
