NODE_ENV=development
API_PORT=3000 
TCP_PORT=5001
DATABASE_URL=postgresql://fleet:fleet@localhost:5432/fleet
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
INTERNAL_TRACKER_SECRET=replace-with-a-third-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only key for geocoding and Nearby Places/Place Details (never EXPO_PUBLIC/VITE).
# Obtain from https://myprojects.geoapify.com/; restrict to your backend IP where appropriate.
GEOAPIFY_API_KEY=
TRACKER_SOCKET_TIMEOUT_MS=300000
# Optional JSON keyed by devices.model. Set only after confirming exact firmware commands/password.
# Explicit probe names use the same JSON in API/tracker/tool; client PDF languageField:false, Concox variant:true.
GT06_RELAY_MODELS={}
MOVEMENT_THRESHOLD_KPH=5
OFFLINE_TIMEOUT_SECONDS=600
NO_SIGNAL_TIMEOUT_MINUTES=30

# Diagnostic packet cadence, independent of offline and unreachable status.
EXPECTED_PACKET_INTERVAL_SECONDS=10

# 32-byte independent AES key (64 hex characters); retain securely across deploys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_PASSWORD_ENCRYPTION_KEY=

# Address display: gps (default), or cell (never silently falls back to GPS).
ADDRESS_SOURCE=gps
OPENCELLID_API_KEY=
# Set only after confirming the GT06 modem technology; leave blank for unknown/mixed hardware.
GT06_CELL_RADIO=
