{
  "name": "fleet-tracking-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
"dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\pnpm.ps1 --filter @fleet/api dev",
"dev:tracker": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\pnpm.ps1 --filter @fleet/tracker dev",
"dev:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\pnpm.ps1 --filter @fleet/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @fleet/api migrate"
  },
  "devDependencies": { "typescript": "^5.7.3", "tsx": "^4.19.2", "vitest": "^2.1.8", "eslint": "^9.17.0", "@eslint/js": "^9.17.0", "typescript-eslint": "^8.19.1" }
}
